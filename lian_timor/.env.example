# Salin menjadi .env lalu isi. JANGAN commit .env
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# sqlite (mudah, untuk belajar) atau postgres
DB_ENGINE=sqlite
DB_NAME=lian_timor
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
