# Salin menjadi .env lalu isi. JANGAN commit .env
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
# 1 HANYA untuk pengembangan di laptop. PRODUKSI: 0 (bawaan bila baris ini dihapus). Tanpa DJANGO_SECRET_KEY dan DEBUG=0, aplikasi menolak jalan.
DJANGO_DEBUG=1
# Produksi (DEBUG=0): HTTPS wajib (mikrofon browser butuh HTTPS). Di belakang nginx yang mengakhiri TLS: DJANGO_BEHIND_PROXY=1. DJANGO_HTTPS=0 hanya uji sementara.
# DJANGO_HTTPS=1
# DJANGO_BEHIND_PROXY=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# sqlite (mudah, untuk belajar) atau postgres
DB_ENGINE=sqlite
DB_NAME=lafex
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# ===== Percakapan suara dengan AI =====
# dummy = balasan contoh (gratis) | anthropic = model berbayar lewat API (biaya per token ditanggung Anda)
AI_BACKEND=dummy
# AI_BACKEND=local  -> model gratis/open-source di server Anda (lihat docs/MELATIH_AI.md)
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=gemma2:2b
LOCAL_LLM_KEY=
ANTHROPIC_API_KEY=
# claude-opus-5-5 = paling pintar tapi mahal; claude-sonnet-5-5 = menengah; claude-haiku-5-5 = paling murah
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
AI_BATAS_HARI=40
AI_BATAS_HARI_TAMU=10

# ===== Suara: Whisper (suara->teks) dan XTTS (teks->suara), server milik sendiri. Kosong = mati =====
STT_URL=
STT_MODEL=whisper-1
TTS_URL=
TTS_SUARA=lafex
TTS_BAHASA=pt

# 0 (bawaan) = siswa memilih di halaman Siswa lalu satu klik ke Video Call; 1 = pelajar langsung dialihkan ke Video Call
HOME_LANGSUNG_BICARA=0

# ===== Batas per alamat IP (selain batas per akun). Pengguna ponsel sering berbagi IP (operator/CGNAT, sekolah): angka sengaja longgar =====
# BATAS_IP_TAMU_JAM=60      # akun tamu baru per IP per jam
# BATAS_IP_DAFTAR_JAM=30    # pendaftaran per IP per jam
# BATAS_IP_TTS_MENIT=120    # sintesis suara XTTS (GPU) per IP per menit
# Di belakang nginx WAJIB DJANGO_BEHIND_PROXY=1 dan nginx harus memakai: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# (tanpa itu semua pengguna terlihat sebagai satu alamat: alamat nginx).
