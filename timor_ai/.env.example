# Salin jadi .env lalu isi. JANGAN commit file .env!
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database: "postgres" (default) atau "sqlite" (untuk coba cepat tanpa PostgreSQL)
DB_ENGINE=postgres
DB_NAME=lafex_ai
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Backend LLM: "dummy" (tanpa model, untuk tes alur) atau "hf" (Hugging Face)
LLM_BACKEND=dummy   # dummy | hf (Gemma lokal) | anthropic (model berbayar lewat API)
LLM_MODEL_ID=google/gemma-2-2b-it
LLM_LORA_PATH=
HF_TOKEN=
# bfloat16 (hemat RAM, disarankan) | float32 (lebih boros, bisa lebih stabil di CPU lama)
LLM_DTYPE=bfloat16
LLM_MAX_NEW_TOKENS=300

# Model embedding untuk RAG. "hash" = tanpa model (hanya untuk tes), atau nama model HF
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small

# ===== Model berbayar lewat API (LLM_BACKEND=anthropic) =====
# Buat kunci di console.anthropic.com. SIMPAN di server saja. Atur batas pengeluaran bulanan di Console!
ANTHROPIC_API_KEY=
# claude-opus-5-5 = paling pintar tapi mahal; claude-sonnet-5-5 = menengah; claude-haiku-5-5 = paling murah
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=2048

# ===== Poin & tagihan =====
# Isi harga token sesuai model di atas (USD per 1 juta token). Contoh Opus 5.5: 4 dan 20 | Sonnet 5.5: 2 dan 10 | Haiku 5.5: 0.1 dan 0.5
PRICE_IN_PER_M=4.0
PRICE_OUT_PER_M=20.0
BILLING_MARGIN=3.0
POINTS_PER_USD=1000
TRIAL_CREDITS=100
MIN_BALANCE_TO_CHAT=20
MAX_MESSAGES_PER_MINUTE=10

# ===== Login email + Facebook =====
# "mandatory" = wajib verifikasi email. Untuk coba lokal boleh "optional"
ACCOUNT_EMAIL_VERIFICATION=mandatory
# Dari developers.facebook.com > App > Settings > Basic. Kosong = tombol Facebook disembunyikan
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# SMTP untuk kirim email verifikasi (kosong = email tampil di terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ===== Hadiah crowdsourcing bahasa daerah =====
CONTRIB_REWARD_VERIFIED=50
CONTRIB_REWARD_VOTE=2
CONTRIB_MAX_SUBMISSIONS_PER_DAY=40
CONTRIB_MAX_VOTES_PER_DAY=100
